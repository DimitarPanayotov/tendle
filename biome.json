{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error",
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "error"
      }
    }
  },
  "files": {
    "includes": ["**", "!.factory"]
  },
  "overrides": [
    {
      "includes": ["src/**", "!src/**/*.test.ts", "!src/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "process": "src/ runs on Cloudflare or in the browser, not in Node.",
                  "Buffer": "src/ runs on Cloudflare or in the browser, not in Node.",
                  "require": "src/ uses ES modules.",
                  "__dirname": "src/ runs on Cloudflare or in the browser, not in Node.",
                  "__filename": "src/ runs on Cloudflare or in the browser, not in Node.",
                  "global": "src/ runs on Cloudflare or in the browser, not in Node."
                }
              }
            }
          }
        }
      }
    }
  ]
}
